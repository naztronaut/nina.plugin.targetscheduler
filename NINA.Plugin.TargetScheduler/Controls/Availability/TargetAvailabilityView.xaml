<UserControl
    x:Class="NINA.Plugin.TargetScheduler.Controls.Availability.TargetAvailabilityView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/Resources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  Night cell: imagable time span(s) and total time, dimmed when not imagable  -->
            <DataTemplate x:Key="AvailabilityCellTemplate">
                <Border
                    Width="120"
                    Padding="4,2,4,2"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1,0,0,0"
                    ToolTip="{Binding ToolTip}">
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="{Binding Text}"
                        TextWrapping="Wrap">
                        <TextBlock.Style>
                            <!--  A local style replaces NINA's implicit TextBlock style, so the theme text color must be set explicitly  -->
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                        <Setter Property="Opacity" Value="0.65" />
                                        <Setter Property="FontStyle" Value="Italic" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </DataTemplate>

            <ItemsPanelTemplate x:Key="HorizontalPanel">
                <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <Border
            Margin="0,10,0,10"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1">
            <StackPanel>
                <TextBlock
                    Width="560"
                    Margin="15"
                    HorizontalAlignment="Left"
                    FontStyle="Italic"
                    Text="Shows when each active target could be imaged over the coming nights. Click the checkmark to prioritize a target (through the last night shown; change the date on the row as needed). While prioritized, a target is imaged in preference to any other target whenever it can be imaged; at other times the scheduler falls back to the remaining targets."
                    TextWrapping="Wrap" />

                <Grid
                    Width="560"
                    Margin="5,5,5,10"
                    HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="400" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition MinHeight="28" />
                        <RowDefinition MinHeight="28" />
                        <RowDefinition MinHeight="28" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Text="Profile" />
                    <ComboBox
                        Grid.Row="0"
                        Grid.Column="1"
                        Width="220"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        DisplayMemberPath="Value"
                        IsEnabled="{Binding IsCalculating, Converter={StaticResource InverseBooleanConverter}}"
                        ItemsSource="{Binding ProfileChoices}"
                        SelectedValue="{Binding SelectedProfileId}"
                        SelectedValuePath="Key" />

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Text="Nights" />
                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="1"
                        Orientation="Horizontal">
                        <ComboBox
                            Width="50"
                            VerticalAlignment="Center"
                            ItemsSource="{Binding NightCountChoices}"
                            SelectedItem="{Binding NightCount}" />
                        <TextBlock
                            Margin="6,0,6,0"
                            VerticalAlignment="Center"
                            Text="starting" />
                        <DatePicker VerticalAlignment="Center" SelectedDate="{Binding StartDate}" />
                    </StackPanel>

                    <StackPanel
                        Grid.Row="2"
                        Grid.Column="1"
                        Orientation="Horizontal">
                        <Button
                            Width="90"
                            Height="25"
                            Margin="0,3,0,0"
                            Command="{Binding CalculateCommand}"
                            Content="Calculate"
                            IsEnabled="{Binding IsCalculating, Converter={StaticResource InverseBooleanConverter}}"
                            ToolTip="Calculate target availability" />
                        <Button
                            Width="90"
                            Height="25"
                            Margin="4,3,0,0"
                            Command="{Binding SaveCommand}"
                            Content="Save"
                            IsEnabled="{Binding HasChanges}"
                            ToolTip="Save target priority changes" />
                        <Button
                            Width="90"
                            Height="25"
                            Margin="4,3,0,0"
                            Command="{Binding RevertCommand}"
                            Content="Revert"
                            IsEnabled="{Binding HasChanges}"
                            ToolTip="Discard unsaved target priority changes" />
                    </StackPanel>
                </Grid>

                <TextBlock
                    MaxWidth="900"
                    Margin="15,0,15,10"
                    HorizontalAlignment="Left"
                    Text="{Binding StatusText}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <ScrollViewer
            MaxHeight="600"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto"
            Visibility="{Binding HasResults, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}">
            <StackPanel>
                <!--  Header  -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Width="30"
                        FontWeight="Bold"
                        Text=""
                        ToolTip="Prioritize" />
                    <TextBlock
                        Width="220"
                        FontWeight="Bold"
                        Text="Target" />
                    <TextBlock
                        Width="60"
                        FontWeight="Bold"
                        Text="Done" />
                    <TextBlock
                        Width="140"
                        FontWeight="Bold"
                        Text="Prioritize Through" />
                    <ItemsControl ItemsPanel="{StaticResource HorizontalPanel}" ItemsSource="{Binding NightHeaders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Width="120"
                                    Padding="5,0,0,0"
                                    FontWeight="Bold"
                                    Text="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!--  When the prioritized targets can be imaged, per night  -->
                <Border
                    Margin="0,4,0,4"
                    Background="{StaticResource SecondaryBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="450"
                            Padding="4,2,0,2"
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Text="Prioritized targets can be imaged"
                            ToolTip="When at least one prioritized target can be imaged.  Outside of these times the scheduler will image other targets." />
                        <ItemsControl
                            ItemTemplate="{StaticResource AvailabilityCellTemplate}"
                            ItemsPanel="{StaticResource HorizontalPanel}"
                            ItemsSource="{Binding CoverageCells}" />
                    </StackPanel>
                </Border>

                <!--  Targets  -->
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Padding="0,3,0,3"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,0,0,1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <!--  Translucent green so the tint works over light or dark themes  -->
                                            <DataTrigger Binding="{Binding IsPrioritized}" Value="True">
                                                <Setter Property="Background" Value="#3300A040" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Button
                                        Width="25"
                                        Height="25"
                                        Margin="2,0,3,0"
                                        VerticalAlignment="Center"
                                        Command="{Binding TogglePriorityCommand}"
                                        Style="{StaticResource BackgroundButton}"
                                        ToolTip="Toggle: prioritize this target">
                                        <Grid>
                                            <Path
                                                Margin="5"
                                                Data="{StaticResource SS_CheckMarkSVG}"
                                                Fill="{StaticResource ButtonForegroundBrush}"
                                                Stretch="Uniform"
                                                Visibility="{Binding IsPrioritized, Converter={StaticResource InverseBooleanToVisibilityCollapsedConverter}}" />
                                            <Path
                                                Margin="5"
                                                Data="{StaticResource SS_CheckMarkSVG}"
                                                Fill="Green"
                                                Stretch="Uniform"
                                                Visibility="{Binding IsPrioritized, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}" />
                                        </Grid>
                                    </Button>
                                    <StackPanel
                                        Width="220"
                                        VerticalAlignment="Center">
                                        <TextBlock
                                            FontWeight="Bold"
                                            Text="{Binding TargetName}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Opacity="0.7"
                                            Text="{Binding ProjectName}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock
                                        Width="60"
                                        VerticalAlignment="Center"
                                        Text="{Binding PercentComplete, Converter={StaticResource PercentDisplayConverter}}" />
                                    <DatePicker
                                        Width="130"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        SelectedDate="{Binding PrioritizeThrough, Mode=TwoWay}"
                                        ToolTip="Prioritized through the night starting on this date (clear to turn off)" />
                                    <ItemsControl
                                        ItemTemplate="{StaticResource AvailabilityCellTemplate}"
                                        ItemsPanel="{StaticResource HorizontalPanel}"
                                        ItemsSource="{Binding NightCells}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </StackPanel>
</UserControl>
